# Non-secret GitHub App configuration. Copy this file to terraform.tfvars,
# which is gitignored, and replace the Client ID with the writer App's value.
github_organization        = "mas-workspace"
github_writer_app_client_id = "Iv_REPLACE_WITH_WRITER_APP_CLIENT_ID"

# Non-secret Git author metadata. Use an email GitHub associates with the
# personal account connected to the Vercel Pro team, preferably its no-reply address.
software_builder_git_author_name  = "REPLACE_WITH_GITHUB_DISPLAY_NAME"
software_builder_git_author_email = "REPLACE_WITH_GITHUB_NOREPLY_EMAIL"

# Non-secret Vercel configuration. The token itself belongs only in SSM.
vercel_team_id = "team_REPLACE_WITH_VERCEL_TEAM_ID"

# Optional. The default is /<project_name>/github/writer-private-key.
# github_writer_private_key_ssm_parameter_name = "/financial-research-agents/github/writer-private-key"

# Optional. The default is /<project_name>/vercel/access-token.
# vercel_access_token_ssm_parameter_name = "/financial-research-agents/vercel/access-token"
