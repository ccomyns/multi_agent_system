#!/bin/bash
set -euo pipefail
runtime_bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec /usr/bin/env -i \
  PATH="/opt/multi-agent/venv/bin:/usr/local/bin:/usr/bin:/bin" \
  HOME="/var/lib/multi-agent" LANG="C.UTF-8" \
  AWS_REGION="$AWS_REGION" AWS_DEFAULT_REGION="$AWS_REGION" \
  FUNCTION_NAME="$FUNCTION_NAME" JOB_ID="$JOB_ID" \
  ORCHESTRATOR_INSTANCE_ID="$ORCHESTRATOR_INSTANCE_ID" \
  /opt/multi-agent/venv/bin/python "$runtime_bin_dir/software_agents_mcp.py"
