#!/bin/bash
set -euo pipefail

# The runner normally exits as soon as its result has been uploaded. The timeout
# is a billing and failure-containment backstop for a hung Codex process.
runtime_bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec /usr/bin/timeout --signal=TERM --kill-after=300s \
  "${SUBAGENT_TTL_SECONDS}s" \
  /opt/multi-agent/venv/bin/python \
  "$runtime_bin_dir/subagent_runner.py"
