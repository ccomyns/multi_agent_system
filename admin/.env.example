# The endpoint remains unavailable unless this explicit safety switch is enabled.
STRESS_TESTS_ENABLED=false

# Server-side AWS configuration for the <project>-admin-server IAM user.
# Create access keys outside Terraform so secrets never land in state.
AWS_REGION=us-east-1
JOB_LAUNCHER_ACCESS_KEY=
JOB_LAUNCHER_SECRET_ACCESS_KEY=

STRESS_TEST_LAUNCH_TEMPLATE_ID=lt-00000000000000000
STRESS_TEST_LAUNCH_TEMPLATE_VERSION=1

# Job launches: one record per run plus a single active-job lock live in this table.
JOBS_TABLE_NAME=financial-research-agents-jobs
ORCHESTRATOR_LAUNCH_TEMPLATE_ID=lt-00000000000000000
ORCHESTRATOR_LAUNCH_TEMPLATE_VERSION=$Default

# The orchestrator writes its report here; the admin server polls it for results.
AUDIT_BUCKET_NAME=financial-research-agents-audit-example
